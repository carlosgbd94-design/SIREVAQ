{
  "manifest_version": 3,
  "name": "SIREVAQ → CeNSIA",
  "short_name": "SIREVAQ-CeNSIA",
  "version": "1.1.1",
  "description": "Rellena en CeNSIA las dosis de Influenza y COVID-19 que ya validaste en SIREVAQ. Tú revisas y pulsas Guardar.",
  "permissions": ["storage"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://carlosgbd94-design.github.io/SIREVAQ/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content_sirevaq.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://siscensia.salud.gob.mx/influenza26/ssa/captura.php*"],
      "js": ["content_censia.js"],
      "run_at": "document_idle"
    }
  ]
}
