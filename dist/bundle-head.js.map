    else colocar(hojaUrb, hojaUrb.name, nombreBase[0], cols.urbanas);
    if (muni === "QUERETARO" && !(soloClues && !cols.rurales.length)) colocar(hojaRur, hojaRur.name, nombreBase[1], cols.rurales);
