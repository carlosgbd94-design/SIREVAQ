function resetCONS() {
  if (HAS_TODAY_CONS && TODAY_CACHE && TODAY_CACHE.cons) {
    loadCONSIntoForm(TODAY_CACHE.cons);
  } else {
    if ($("nombreCONS")) $("nombreCONS").value = "";
