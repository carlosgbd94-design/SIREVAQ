                  { offset: 1, color: '#1d4ed8' }
                ])
              }
            }
          ]
        }]
      });

      window.CHART_CAD = echarts.init(ctxRight);
      window.CHART_CAD.setOption({
        animationDuration: 1000, animationEasing: 'exponentialOut',
