document.addEventListener("click", (e) => {
  if (e.target.closest("#btnLoteSelectAll")) {
    document.querySelectorAll(".loteMuniChk").forEach(chk => chk.checked = true);
  }
  if (e.target.closest("#btnLoteClearAll")) {
