  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  const fmt = (n) => Number(n || 0).toLocaleString("es-MX");
  const MARCA_TXT = { MODERNA: "Moderna", PFIZER: "Pfizer" };
