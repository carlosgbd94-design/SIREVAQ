  "COVID 19":          "#4A4A4A",
  "HepA":              "#4b5563",
  "HEPATITIS A":       "#4b5563",
  "Hepatitis A":       "#4b5563",
  "SABIN":             "#16a34a"
};

window.getBiologicoColor = function(name) {
  if (!name) return "#0f172a";
  const clean = String(name).trim().toUpperCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  // Buscar coincidencia exacta primero
  for (const [key, color] of Object.entries(window.BIOLOGICO_COLORS)) {
    const normKey = key.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toUpperCase();
    if (clean === normKey) return color;
  }
  // Coincidencia por subcadena
  for (const [key, color] of Object.entries(window.BIOLOGICO_COLORS)) {
    const normKey = key.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toUpperCase();
    if (clean.includes(normKey) || normKey.includes(clean)) return color;
  }
  return "#0f172a";
};

// Color de texto accesible para un biológico: oscurece el color de marca hasta 4.5:1 sobre blanco
window.getBiologicoTextColor = function(name) {
  const hex = String(window.getBiologicoColor(name) || "#0f172a").replace("#", "");
  const full = hex.length === 3 ? hex.split("").map(c => c + c).join("") : hex;
  let rgb = [0, 2, 4].map(i => parseInt(full.substr(i, 2), 16));
  if (rgb.some(isNaN)) return "#0f172a";
  const lum = c => { const [r, g, b] = c.map(v => { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); }); return 0.2126 * r + 0.7152 * g + 0.0722 * b; };
  for (let i = 0; i < 20 && 1.05 / (lum(rgb) + 0.05) < 5.5; i++) rgb = rgb.map(v => Math.round(v * 0.88));
  return "#" + rgb.map(v => v.toString(16).padStart(2, "0")).join("");
};

