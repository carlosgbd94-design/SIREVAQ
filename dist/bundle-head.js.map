        const normText = (s) => String(s || "").trim().toUpperCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const filtered = filteredData.filter(d => exportRowEnSeleccion_(d.clues, d.municipio, payload.municipios));

