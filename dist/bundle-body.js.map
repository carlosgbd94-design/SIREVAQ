/* ---- auditoria_console.js ---- */
/**
 * auditoria_console.js — Panel "Auditoría de Datos" (SIREVAQ, ADMIN)
 * Corre la RPC get_audit_findings (Postgres, restringida a ADMIN por RLS/RAISE EXCEPTION) y
 * renderiza los hallazgos como tabla. No modifica nada: es de solo lectura, cada hallazgo se
 * corrige manualmente después de revisarlo (igual que se hizo hoy a mano para varios casos reales).
 */

const AUDIT_SEVERIDAD_LABEL = { alta: 'Alta', media: 'Media', baja: 'Baja' };
const AUDIT_SEVERIDAD_COLOR = { alta: '#dc2626', media: '#d97706', baja: '#64748b' };
const AUDIT_CATEGORIA_LABEL = {
    clues_formato: 'CLUES con formato inválido',
    unidad_huerfana: 'Unidad huérfana',
    unidad_sin_ficha_medica: 'Unidad sin ficha médica',
    poblacion_duplicada_sospechosa: 'Población duplicada entre años',
    meses_faltantes: 'Meses faltantes',
    mapeo_duplicado_mayusculas: 'Mapeo SIS duplicado (mayúsculas)',
    rpc_sin_verificacion_rol: 'RPC sin verificación de rol'
};

window.initConsoleAuditoria = function() {
    const role = String((window.USER || {}).rol || (window.USER || {}).role || '').toUpperCase();
    if (role !== 'ADMIN') {
        const container = document.getElementById('adminSection_auditoria');
        if (container) {
            container.innerHTML = `
                <div style="padding: 40px; text-align: center; background: #ffffff; border-radius: 20px; border: 1px solid #e2e8f0; margin-top: 20px;">
                    <div style="font-size: 32px; margin-bottom: 12px;">🚫</div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a;">Acceso Restringido</h3>
                    <p style="margin-top: 6px; font-size: 13px; color: #64748b;">Solo Admin puede correr la auditoría de datos.</p>
                </div>
            `;
        }
    }
};

window.auditRunFindings = async function() {
    const tbody = document.getElementById('auditFindingsTbody');
    const summaryBar = document.getElementById('auditSummaryBar');
    const btn = document.getElementById('btnRunAuditFindings');
    if (!tbody) return;

    if (btn) btn.disabled = true;
    if (typeof showOverlay === 'function') {
        showOverlay('Corriendo auditoría de integridad de datos...', 'Auditoría de Datos');
    }
    tbody.innerHTML = `<tr><td colspan="4" class="px-6 py-4 text-center text-slate-400">Consultando...</td></tr>`;

    try {
        const currentYear = new Date().getFullYear();
        const { data, error } = await window.supabase.rpc('get_audit_findings', { p_anio: currentYear });
        if (error) throw error;

        const findings = data || [];

        if (summaryBar) {
            summaryBar.style.display = 'block';
            const counts = { alta: 0, media: 0, baja: 0 };
            findings.forEach(f => { counts[f.severidad] = (counts[f.severidad] || 0) + 1; });
            summaryBar.textContent = findings.length === 0
                ? `Sin hallazgos para ${currentYear}. Última corrida: ${new Date().toLocaleString('es-MX')}.`
                : `${findings.length} hallazgo(s) para ${currentYear} — Alta: ${counts.alta || 0} · Media: ${counts.media || 0} · Baja: ${counts.baja || 0}. Última corrida: ${new Date().toLocaleString('es-MX')}.`;
        }

        if (findings.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" class="px-6 py-4 text-center text-slate-400">Sin hallazgos — no se detectó ningún problema.</td></tr>`;
        } else {
            const severidadOrder = { alta: 0, media: 1, baja: 2 };
            findings.sort((a, b) => (severidadOrder[a.severidad] ?? 9) - (severidadOrder[b.severidad] ?? 9));

            tbody.innerHTML = findings.map(f => {
                const color = AUDIT_SEVERIDAD_COLOR[f.severidad] || '#64748b';
                const sevLabel = AUDIT_SEVERIDAD_LABEL[f.severidad] || f.severidad;
                const catLabel = AUDIT_CATEGORIA_LABEL[f.categoria] || f.categoria;
                return `
                    <tr>
                        <td class="px-6 py-3"><span style="display:inline-block; padding:3px 10px; border-radius:999px; font-size:10.5px; font-weight:800; color:#fff; background:${color};">${sevLabel}</span></td>
                        <td class="px-6 py-3" style="font-weight:700; font-size:12.5px; color:#0f172a;">${catLabel}</td>
                        <td class="px-6 py-3" style="font-family:monospace; font-size:12px; color:#475569;">${f.clues || '—'}</td>
                        <td class="px-6 py-3" style="font-size:12.5px; color:#334155;">${f.descripcion || ''}</td>
                    </tr>
                `;
            }).join('');
        }

        if (typeof showToast === 'function') {
            showToast(`Auditoría completa: ${findings.length} hallazgo(s)`, true, findings.length === 0 ? 'good' : 'warn');
        }
    } catch (e) {
        console.error('Error al correr auditoría de datos:', e);
        tbody.innerHTML = `<tr><td colspan="4" class="px-6 py-4 text-center" style="color:#dc2626;">Error: ${e.message}</td></tr>`;
        if (typeof showToast === 'function') {
            showToast('Error al correr la auditoría: ' + e.message, false, 'bad');
        }
    } finally {
        if (btn) btn.disabled = false;
        if (typeof hideOverlay === 'function') hideOverlay();
    }
};

;
/* ---- rda_analisis.js ---- */
/* Lectura analítica del avance RDA (esquema básico). Cálculo puro, sin DOM: lo usa rda_ui.js y lo prueban los tests.
 * La fórmula RDA NO cambia: avance = (dosis ÷ divisor) ÷ (población × 0.0833 × meses del corte). Aquí solo se
 * LEE ese avance: ritmo, proyección al cierre, brecha por unidad/municipio, semáforo y concentración. */
(function (root, factory) {
    if (typeof module === 'object' && module.exports) module.exports = factory();
    else root.RdaAnalisis = factory();
})(typeof self !== 'undefined' ? self : this, function () {
    'use strict';

    const FACTOR = 0.0833;
    // Mismos cortes que las tarjetas de avance: >=95 óptimo, >=75 regular, resto crítico.
    const nivelDe = (p) => (p >= 95 ? 'optimo' : p >= 75 ? 'regular' : 'critico');

    // Definición de cada grupo de edad: población, dosis y divisor del esquema básico.
    const GRUPOS = [
        { key: 'menor1', nombre: 'Menores de 1 año', corto: '<1', div: 4, vacunas: '5 vacunas',
          pob: u => u.pob_menor_1 || 0,
          dosis: u => (u.bcg_dosis || 0) + (u.hepb_0_7_dosis || 0) + (u.hexa_3_dosis || 0) + (u.rota_2_dosis || 0) + (u.neumo_2_dosis || 0) },
        { key: 'uno', nombre: 'Niños de 1 año', corto: '1', div: 3, vacunas: '3 vacunas',
          pob: u => u.pob_1_ano || 0,
          dosis: u => (u.hexa_ref_dosis || 0) + (u.neumo_ref_dosis || 0) + (u.srp_2_dosis || 0) },
        { key: 'cuatro', nombre: 'Niños de 4 años', corto: '4', div: 1, vacunas: 'DPT',
          pob: u => u.pob_4_anos || 0,
          dosis: u => u.dpt_4_dosis || 0 }
    ];
    const GRUPO_6 = { key: 'seis', nombre: 'Niños de 6 años', corto: '6', div: 1, vacunas: 'SRP',
        pob: u => u.pob_6_anos || 0, dosis: u => u.srp_6_dosis || 0 };

    const r1 = (n) => Math.round(n * 10) / 10;

    function medidasDe(g, u, mm) {
        const pob = g.pob(u);
        const meta = pob * FACTOR * mm;
        const eq = g.dosis(u) / g.div;
        return { pob, meta, eq, avance: meta > 0 ? eq / meta * 100 : null, brecha: Math.max(0, meta - eq) };
    }

    /** unidades: filas de get_rda_indicators ya filtradas por ámbito. mm: meses del corte (1-12). */
    function analiza(unidades, mm, opciones) {
        opciones = opciones || {};
        mm = Math.min(12, Math.max(1, Number(mm) || 12));
        const grupos = GRUPOS.concat(opciones.anio === 2025 ? [GRUPO_6] : []);
        const res = grupos.map(g => {
            const filas = [];
            let pobT = 0, metaT = 0, eqT = 0;
            for (const u of unidades) {
                const m = medidasDe(g, u, mm);
                pobT += m.pob; metaT += m.meta; eqT += m.eq;
                if (m.meta >= 1) filas.push({ clues: u.clues, nombre: u.nombre || u.clues, municipio: u.municipio || '', ...m });
            }
            const avance = metaT > 0 ? eqT / metaT * 100 : null;
            const restantes = 12 - mm;
            const ritmo = eqT / mm;                       // aplicadas equivalentes por mes, a la fecha
            const anual = pobT * FACTOR * 12;             // meta del año completo
            const proyeccion = eqT + ritmo * restantes;   // cierre si se mantiene el ritmo
            const proyPct = anual > 0 ? proyeccion / anual * 100 : null;
            const faltanAnual = Math.max(0, anual - eqT);
            const ritmoNecesario = restantes > 0 ? faltanAnual / restantes : null;
            const brechaCorte = Math.max(0, metaT - eqT);

            // Semáforo por unidad (solo unidades con población meta)
            const niveles = { optimo: 0, regular: 0, critico: 0 };
            filas.forEach(f => { f.nivel = nivelDe(f.avance); niveles[f.nivel]++; });

            // Brecha: quién concentra lo que falta
            const porBrecha = filas.filter(f => f.brecha > 0).sort((a, b) => b.brecha - a.brecha);
            const brechaUnidades = porBrecha.reduce((s, f) => s + f.brecha, 0);
            let acum = 0, nMitad = 0;
            for (const f of porBrecha) { acum += f.brecha; nMitad++; if (acum >= brechaUnidades * 0.5) break; }

            // Municipios
            const mun = new Map();
            for (const f of filas) {
                const k = f.municipio || 'SIN MUNICIPIO';
                const a = mun.get(k) || { municipio: k, meta: 0, eq: 0, brecha: 0, unidades: 0 };
                a.meta += f.meta; a.eq += f.eq; a.brecha += f.brecha; a.unidades++;
                mun.set(k, a);
            }
            const municipios = [...mun.values()].map(a => ({ ...a, avance: a.meta > 0 ? a.eq / a.meta * 100 : null }))
                .sort((a, b) => b.brecha - a.brecha);

            return {
                key: g.key, nombre: g.nombre, corto: g.corto, vacunas: g.vacunas, div: g.div,
                pob: pobT, meta: metaT, eq: eqT, avance, nivel: avance == null ? null : nivelDe(avance),
                brechaCorte, restantes, ritmo, anual, proyeccion, proyPct, faltanAnual, ritmoNecesario,
                // cuántas veces hay que multiplicar el ritmo actual para cerrar en 100 %
                factorRitmo: ritmoNecesario != null && ritmo > 0 ? ritmoNecesario / ritmo : null,
                niveles, unidadesConMeta: filas.length,
                filas, topBrecha: porBrecha.slice(0, 5), nMitadBrecha: nMitad, brechaUnidades,
                municipios, mejores: filas.slice().sort((a, b) => b.avance - a.avance).slice(0, 3)
            };
        });
        return { mm, grupos: res, titulares: titulares(res, mm) };
    }

    // Frases cortas y accionables que cruzan los grupos (las tarjetas ya dicen lo propio de cada grupo).
    function titulares(gs, mm) {
        const out = [];
        const fmt = (n) => Math.round(n).toLocaleString('es-MX');
        const ok = gs.filter(g => g.avance != null);
        if (!ok.length) return out;
        const restantes = 12 - mm;

        if (restantes > 0) {
            const sinAlcanzar = ok.filter(g => g.proyPct != null && g.proyPct < 100);
            const lejano = ok.filter(g => g.factorRitmo != null).sort((a, b) => b.factorRitmo - a.factorRitmo)[0];
            if (!sinAlcanzar.length) {
                out.push({ prioridad: 1, icon: 'verified', texto: `Quedan ${restantes} ${restantes === 1 ? 'mes' : 'meses'} y, al ritmo actual, los ${ok.length} grupos cierran el año en 100 % o más.` });
            } else if (lejano) {
                out.push({ prioridad: 1, icon: 'speed', texto: `Quedan ${restantes} ${restantes === 1 ? 'mes' : 'meses'}: al ritmo actual ${sinAlcanzar.length === ok.length ? 'ningún grupo' : sinAlcanzar.length + ' de ' + ok.length + ' grupos no'} llega${sinAlcanzar.length === ok.length ? '' : 'n'} al 100 % anual. El más lejano es ${lejano.nombre.toLowerCase()}: necesita ${(Math.round(lejano.factorRitmo * 10) / 10)}× su ritmo actual.` });
            }
        }

        // Concentración: el grupo donde menos unidades explican la mitad del rezago
        const conc = ok.filter(g => g.unidadesConMeta >= 6 && g.nMitadBrecha > 0 && g.brechaUnidades > 0)
            .sort((a, b) => a.nMitadBrecha / a.unidadesConMeta - b.nMitadBrecha / b.unidadesConMeta)[0];
        if (conc) out.push({ prioridad: 2, icon: 'filter_alt', texto: `El rezago está concentrado: en ${conc.nombre.toLowerCase()}, ${conc.nMitadBrecha} de ${conc.unidadesConMeta} unidades suman la mitad de lo que falta (${fmt(conc.brechaUnidades)} equivalentes).` });

        // Municipio y unidad con más rezago sumando los grupos
        const mun = new Map(), uni = new Map();
        let total = 0;
        for (const g of ok) for (const f of g.filas) {
            if (f.brecha <= 0) continue;
            total += f.brecha;
            const km = f.municipio || 'SIN MUNICIPIO';
            mun.set(km, (mun.get(km) || 0) + f.brecha);
            const u = uni.get(f.clues) || { nombre: f.nombre, municipio: f.municipio, brecha: 0 };
            u.brecha += f.brecha; uni.set(f.clues, u);
        }
        if (total > 0 && mun.size > 1) {
            const [m, b] = [...mun.entries()].sort((a, c) => c[1] - a[1])[0];
            out.push({ prioridad: 3, icon: 'location_on', texto: `${m} aporta ${Math.round(b / total * 100)} % del rezago jurisdiccional sumando los grupos (${fmt(b)} de ${fmt(total)} equivalentes).` });
        }
        if (total > 0 && uni.size > 3) {
            const u = [...uni.values()].sort((a, c) => c.brecha - a.brecha)[0];
            out.push({ prioridad: 3, icon: 'domain', texto: `${u.nombre} es la unidad con más rezago: ${Math.round(u.brecha / total * 100)} % del total (${fmt(u.brecha)} equivalentes).` });
        }
        return out.sort((a, b) => a.prioridad - b.prioridad);
    }

    // ── Esquemas de solo dosis (adolescentes/adultos, mayores, embarazadas, adicionales): no hay población meta,
    // así que se lee la distribución: qué biológico pesa, qué municipio/unidades concentran y quién no aplicó.
    const ESQUEMAS_DOSIS = {
        adultos: [['HepB', 'adol_hb'], ['SR', 'adol_sr'], ['VPH', 'adol_vph'], ['Td', 'adol_td'], ['Tdpa', 'adol_tdpa']],
        mayores: [['Neumo 13', 'am_neumo13'], ['Neumo 20', 'am_neumo20'], ['Td mayores', 'am_td']],
        embarazadas: [['Tdpa', 'emb_tdpa'], ['VSR', 'emb_vsr']],
        adicionales: [['Varicela', 'varicela'], ['Hepatitis A', 'hepatitis_a']]
    };

    function analizaDosis(unidades, esquema) {
        const defs = ESQUEMAS_DOSIS[esquema];
        if (!defs) return null;
        const us = unidades.map(u => {
            const por = defs.map(([, campo]) => Number(u[campo]) || 0);
            return { clues: u.clues, nombre: u.nombre || u.clues, municipio: u.municipio || 'SIN MUNICIPIO', por, total: por.reduce((a, b) => a + b, 0) };
        });
        const total = us.reduce((a, u) => a + u.total, 0);
        const bios = defs.map(([label], i) => {
            const t = us.reduce((a, u) => a + u.por[i], 0);
            const aplicaron = us.filter(u => u.por[i] > 0).length;
            const top = us.filter(u => u.por[i] > 0).sort((a, b) => b.por[i] - a.por[i]).slice(0, 3).map(u => ({ nombre: u.nombre, municipio: u.municipio, dosis: u.por[i] }));
            return { label, total: t, share: total > 0 ? t / total * 100 : 0, aplicaron, sin: us.length - aplicaron, top };
        });
        const mun = new Map();
        us.forEach(u => { const m = mun.get(u.municipio) || { municipio: u.municipio, dosis: 0, unidades: 0 }; m.dosis += u.total; m.unidades++; mun.set(u.municipio, m); });
        const municipios = [...mun.values()].sort((a, b) => b.dosis - a.dosis);
        const ordenadas = us.filter(u => u.total > 0).sort((a, b) => b.total - a.total);
        let acum = 0, nMitad = 0;
        for (const u of ordenadas) { acum += u.total; nMitad++; if (acum >= total * 0.5) break; }
        const sinDosis = us.filter(u => u.total === 0);
        const out = { total, unidades: us.length, bios, municipios, sinDosis, nMitad, conDosis: ordenadas.length, titulares: [] };
        const fmt = (n) => Math.round(n).toLocaleString('es-MX');
        const pct = (n) => (Math.round(n * 10) / 10).toLocaleString('es-MX');
        if (total > 0) {
            const g = bios.slice().sort((a, b) => b.total - a.total)[0];
            if (bios.length > 1) out.titulares.push({ icon: 'vaccines', texto: `${g.label} es el biológico que más pesa: ${pct(g.share)} % de las ${fmt(total)} dosis del esquema.` });
            const m = municipios[0];
            if (municipios.length > 1 && m.dosis > 0) out.titulares.push({ icon: 'location_on', texto: `${m.municipio} aplica ${pct(m.dosis / total * 100)} % de las dosis con ${pct(m.unidades / us.length * 100)} % de las unidades.` });
            if (ordenadas.length >= 6) out.titulares.push({ icon: "filter_alt", texto: nMitad === 1 ? `${ordenadas[0].nombre} sola suma la mitad de las dosis del esquema.` : `${nMitad} de ${ordenadas.length} unidades que aplicaron suman la mitad de las dosis.` });
        }
        if (us.length > 1 && sinDosis.length) {
            const nombres = sinDosis.length <= 4 ? `: ${sinDosis.map(u => u.nombre).join(', ')}` : '';
            out.titulares.push({ icon: 'report', texto: `${sinDosis.length} de ${us.length} unidades no registran ninguna dosis de este esquema${nombres}.` });
        }
        return out;
    }

    /** Compara el avance de cada unidad en dos años (mismo CLUES). u25/u26: filas de get_rda_indicators;
     *  mm25/mm26: meses del corte de cada año. "Mejoró" y "cayó" usan una banda de ±3 puntos como la tabla comparativa. */
    function comparaAnios(u25, u26, mm25, mm26) {
        const por25 = new Map(u25.map(u => [u.clues, u]));
        const BANDA = 3;
        const fmt = (n) => (Math.round(n * 10) / 10).toLocaleString('es-MX');
        const grupos = GRUPOS.map(g => {
            const filas = [];
            for (const u of u26) {
                const v = por25.get(u.clues);
                if (!v) continue;
                const a = medidasDe(g, v, mm25), b = medidasDe(g, u, mm26);
                if (a.meta < 1 || b.meta < 1) continue;
                filas.push({ clues: u.clues, nombre: u.nombre || u.clues, municipio: u.municipio || '', av25: a.avance, av26: b.avance, delta: b.avance - a.avance, metaMin: Math.min(a.meta, b.meta) });
            }
            const mejoran = filas.filter(f => f.delta > BANDA).length;
            const caen = filas.filter(f => f.delta < -BANDA).length;
            // Rankings: al menos 30 aplicaciones de meta al corte en ambos años. Una unidad móvil con población casi nula
            // daría porcentajes de cientos y taparía lo importante (sigue contando en el semáforo).
            const ord = filas.filter(f => f.metaMin >= 30).sort((x, y) => y.delta - x.delta);
            return { key: g.key, nombre: g.nombre, comparables: filas.length, mejoran, caen, estables: filas.length - mejoran - caen,
                mejores: ord.filter(f => f.delta > 0).slice(0, 3), peores: ord.slice().reverse().filter(f => f.delta < 0).slice(0, 3) };
        });
        const titulares = [];
        for (const g of grupos) {
            if (g.comparables >= 5) titulares.push({ icon: g.caen > g.mejoran ? 'trending_down' : 'trending_up',
                texto: `${g.nombre}: ${g.mejoran} de ${g.comparables} unidades avanzan más que el año pasado, ${g.estables} se mantienen y ${g.caen} van por debajo.` });
        }
        const todas = grupos.flatMap(g => g.peores.map(f => ({ ...f, grupo: g.nombre })));
        const caida = todas.sort((a, b) => a.delta - b.delta)[0];
        if (caida) titulares.push({ icon: 'warning', texto: `Mayor caída: ${caida.nombre} (${caida.grupo.toLowerCase()}) pasó de ${fmt(caida.av25)} % a ${fmt(caida.av26)} % (${fmt(caida.delta)} pts).` });
        const subidas = grupos.flatMap(g => g.mejores.map(f => ({ ...f, grupo: g.nombre })));
        const alza = subidas.sort((a, b) => b.delta - a.delta)[0];
        if (alza) titulares.push({ icon: 'emoji_events', texto: `Mayor avance: ${alza.nombre} (${alza.grupo.toLowerCase()}) pasó de ${fmt(alza.av25)} % a ${fmt(alza.av26)} % (+${fmt(alza.delta)} pts).` });
        return { grupos, titulares };
    }

    // ── Vista "Por biológico": misma fórmula de la tabla (dosis del biológico ÷ meta al corte de su grupo, sin divisor)
    const BIOLOGICOS = [
        { key: 'v1', nombre: 'BCG', grupo: 'menor1', dosis: u => u.bcg_dosis || 0 },
        { key: 'v2', nombre: 'Hepatitis B', grupo: 'menor1', dosis: u => u.hepb_0_7_dosis || 0 },
        { key: 'v3', nombre: 'Rotavirus', grupo: 'menor1', dosis: u => u.rota_2_dosis || 0 },
        { key: 'v4', nombre: 'Hexavalente <1 año', multi: true, grupo: 'menor1', dosis: u => (u.hexa_1_dosis || 0) + (u.hexa_2_dosis || 0) + (u.hexa_3_dosis || 0) },
        { key: 'v5', nombre: 'Hexavalente 1 año', grupo: 'uno', dosis: u => u.hexa_ref_dosis || 0 },
        { key: 'v6', nombre: 'Neumocócica <1 año', multi: true, grupo: 'menor1', dosis: u => (u.neumo_1_dosis || 0) + (u.neumo_2_dosis || 0) + (u.neumo_c1_dosis || 0) + (u.neumo_c2_dosis || 0) },
        { key: 'v7', nombre: 'Neumocócica 1 año', grupo: 'uno', dosis: u => (u.neumo_ref_dosis || 0) + (u.neumo_c3_dosis || 0) },
        { key: 'v8', nombre: 'SRP', grupo: 'uno', dosis: u => (u.srp_1_dosis || 0) + (u.srp_2_dosis || 0) },
        { key: 'v9', nombre: 'DPT', grupo: 'cuatro', dosis: u => u.dpt_4_dosis || 0 }
    ];
    const POB_GRUPO = { menor1: u => u.pob_menor_1 || 0, uno: u => u.pob_1_ano || 0, cuatro: u => u.pob_4_anos || 0 };

    function analizaBiologicos(unidades, mm) {
        mm = Math.min(12, Math.max(1, Number(mm) || 12));
        const fmt = (n) => (Math.round(n * 10) / 10).toLocaleString('es-MX');
        const bios = BIOLOGICOS.map(b => {
            const filas = [];
            let metaT = 0, dosT = 0;
            for (const u of unidades) {
                const meta = POB_GRUPO[b.grupo](u) * FACTOR * mm;
                const dos = b.dosis(u);
                metaT += meta; dosT += dos;
                if (meta >= 1) filas.push({ clues: u.clues, nombre: u.nombre || u.clues, municipio: u.municipio || '', meta, dosis: dos, avance: dos / meta * 100, brecha: Math.max(0, meta - dos) });
            }
            const niveles = { optimo: 0, regular: 0, critico: 0 };
            filas.forEach(f => { f.nivel = nivelDe(f.avance); niveles[f.nivel]++; });
            const avance = metaT > 0 ? dosT / metaT * 100 : null;
            const peores = filas.filter(f => f.brecha > 0).sort((a, c) => c.brecha - a.brecha).slice(0, 3);
            return { key: b.key, nombre: b.nombre, multi: !!b.multi, grupo: b.grupo, avance, nivel: avance == null ? null : nivelDe(avance), meta: metaT, dosis: dosT,
                brecha: Math.max(0, metaT - dosT), niveles, unidadesConMeta: filas.length, peores };
        }).filter(b => b.avance != null);
        const orden = bios.slice().sort((a, c) => a.avance - c.avance);
        // Hexavalente y Neumocócica <1 año suman las 3 dosis por niño (la tabla las mide así), por eso pasan de 100 %:
        // no son comparables con los biológicos de una sola dosis y quedan fuera de las frases de más/menos avanzado.
        const comparables = orden.filter(b => !b.multi);
        const titulares = [];
        if (comparables.length > 1) {
            const lo = comparables[0], hi = comparables[comparables.length - 1];
            titulares.push({ icon: 'vaccines', texto: `El biológico más rezagado es ${lo.nombre} (${fmt(lo.avance)} %); el más avanzado, ${hi.nombre} (${fmt(hi.avance)} %). Hay ${fmt(hi.avance - lo.avance)} puntos de distancia.` });
        }
        // Unidades con varios biológicos críticos
        const porUnidad = new Map();
        for (const b of BIOLOGICOS) for (const u of unidades) {
            const meta = POB_GRUPO[b.grupo](u) * FACTOR * mm;
            if (meta < 1) continue;
            const o = porUnidad.get(u.clues) || { nombre: u.nombre || u.clues, n: 0, crit: 0 };
            o.n++; if (b.dosis(u) / meta * 100 < 75) o.crit++;
            porUnidad.set(u.clues, o);
        }
        const todasCrit = [...porUnidad.values()].filter(o => o.n >= 5 && o.crit === o.n);
        if (todasCrit.length) titulares.push({ icon: 'report', texto: `${todasCrit.length} ${todasCrit.length === 1 ? 'unidad está' : 'unidades están'} en nivel crítico en todos sus biológicos con meta${todasCrit.length <= 3 ? `: ${todasCrit.map(o => o.nombre).join(', ')}` : ''}.` });
        return { mm, bios, orden, titulares };
    }

    return { GRUPOS, FACTOR, nivelDe, analiza, titulares, ESQUEMAS_DOSIS, analizaDosis, comparaAnios, BIOLOGICOS, analizaBiologicos };
});

;
/* ---- rda_lectura_ui.js ---- */
/* Panel "Lectura del corte" del esquema básico de Indicadores RDA (usa rda_analisis.js).
 * Se pinta dentro de #rdaDashboardContent, así que la exportación a imagen/ZIP lo incluye; no usa texto sr-only. */
(function () {
    'use strict';
    const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
    const NIVEL = {
        optimo: { txt: 'Óptimo', color: '#10b981', ink: '#047857', icon: 'check_circle' },
        regular: { txt: 'Regular', color: '#f59e0b', ink: '#b45309', icon: 'warning' },
        critico: { txt: 'Crítico', color: '#e11d48', ink: '#be123c', icon: 'error' }
    };
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const n0 = (n) => Math.round(n).toLocaleString('es-MX');
    const p1 = (n) => (Math.round(n * 10) / 10).toLocaleString('es-MX', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const corto = (s) => { s = String(s || ''); return s.length > 30 ? s.slice(0, 29) + '…' : s; };

    function tarjeta(g, unica) {
        const nv = g.nivel ? NIVEL[g.nivel] : null;
        const anualPct = g.anual > 0 ? g.eq / g.anual * 100 : 0;          // lo aplicado, contra la meta de todo el año
        const proyPct = g.proyPct || 0;
        const cortePct = g.mm12 ? 100 : (g.meta / (g.anual || 1)) * 100;   // dónde debería ir hoy
        const escala = Math.max(100, proyPct, anualPct) * 1.04;
        const w = (v) => Math.min(100, Math.max(0, v / escala * 100));
        const cierre = g.restantes === 0;
        const sobre = g.proyPct != null && g.proyPct >= 100;

        let ritmo = '';
        if (!cierre && g.ritmoNecesario != null) {
            const f = g.factorRitmo;
            ritmo = `
            <div class="rl-ritmo">
              <div><span class="rl-k">Ritmo actual</span><b>${n0(g.ritmo)}</b><span class="rl-u">/ mes</span></div>
              <div><span class="rl-k">Necesario para 100 %</span><b>${n0(g.ritmoNecesario)}</b><span class="rl-u">/ mes${f && f > 1.05 ? ` · ${p1(f)}×` : ''}</span></div>
            </div>`;
        } else if (cierre) {
            ritmo = `<div class="rl-ritmo"><div><span class="rl-k">Cierre del año</span><b>${p1(anualPct)} %</b><span class="rl-u">de la meta anual</span></div></div>`;
        }

        let sem = '';
        if (!unica && g.unidadesConMeta > 1) {
            const tot = g.unidadesConMeta;
            const seg = ['optimo', 'regular', 'critico'].filter(k => g.niveles[k] > 0)
                .map(k => `<span class="rl-seg" style="flex:${g.niveles[k]};background:${NIVEL[k].color}" title="${NIVEL[k].txt}: ${g.niveles[k]}"></span>`).join('');
            const leg = ['optimo', 'regular', 'critico'].map(k =>
                `<span class="rl-leg"><i class="rl-dot" style="background:${NIVEL[k].color}"></i>${g.niveles[k]} ${NIVEL[k].txt.toLowerCase()}${g.niveles[k] === 1 ? '' : 's'}</span>`).join('');
            sem = `<div class="rl-sub">${tot} unidades con población meta</div><div class="rl-semaforo">${seg}</div><div class="rl-legs">${leg}</div>`;
        }

        let top = '';
        if (!unica && g.topBrecha.length) {
            const max = g.topBrecha[0].brecha || 1;
            top = `<div class="rl-sub">Donde más falta${g.nMitadBrecha > 0 && g.unidadesConMeta >= 6 ? ` · ${g.nMitadBrecha} unidades suman la mitad` : ''}</div>` +
                g.topBrecha.slice(0, 4).map(f => `
                <div class="rl-fila"><span class="rl-nom" title="${esc(f.nombre)} · ${esc(f.municipio)}">${esc(corto(f.nombre))}</span>
                <span class="rl-barra"><i style="width:${Math.max(3, f.brecha / max * 100)}%;background:${NIVEL[f.nivel].color}"></i></span>
                <span class="rl-num">−${n0(f.brecha)}</span></div>`).join('');
        }

        return `
        <article class="rl-card" data-rl="${g.key}">
          <header><h4>${esc(g.nombre)}</h4>${nv ? `<span class="rl-pill" style="color:${nv.ink}"><span class="material-symbols-rounded" aria-hidden="true">${nv.icon}</span>${nv.txt} · ${p1(g.avance)} %</span>` : ''}</header>
          <div class="rl-pista" aria-label="Avance contra la meta anual">
            <i class="rl-hoy" style="width:${w(anualPct)}%"></i>
            ${!cierre ? `<i class="rl-proy" style="left:${w(anualPct)}%;width:${Math.max(0, w(proyPct) - w(anualPct))}%"></i>` : ''}
            <i class="rl-marca rl-m-corte" style="left:${w(cortePct)}%" title="Meta al corte"></i>
            <i class="rl-marca rl-m-100" style="left:${w(100)}%" title="Meta anual"></i>
          </div>
          <div class="rl-pista-txt">
            <span><b>${p1(anualPct)} %</b> de la meta anual aplicado</span>
            ${!cierre ? `<span>Proyección al cierre: <b style="color:${sobre ? '#047857' : '#be123c'}">${p1(proyPct)} %</b></span>` : ''}
          </div>
          ${ritmo}${sem}${top}
        </article>`;
    }

    window.renderRdaLectura = function (fUnits, mm, anio) {
        const A = window.RdaAnalisis;
        let host = document.getElementById('rdaLecturaCorte');
        if (!A) { if (host) host.remove(); return; }
        const grid = document.getElementById('rdaAnalysisGrid');
        if (!grid) return;
        if (!host) {
            host = document.createElement('section');
            host.id = 'rdaLecturaCorte';
            host.className = 'rl';
            host.setAttribute('aria-label', 'Lectura del corte');
            grid.parentElement.insertBefore(host, grid);
        }
        const r = A.analiza(fUnits, mm, { anio });
        r.grupos.forEach(g => { g.mm12 = r.mm === 12; });
        const unica = fUnits.length <= 1;
        const tit = r.titulares.slice(0, 4);
        host.innerHTML = `
          <div class="rl-head"><h3>Lectura del corte</h3>
            <p>Corte a ${esc(MESES[r.mm - 1])} · ${r.mm} de 12 meses. La barra muestra lo aplicado contra la meta de <b>todo el año</b>; la franja clara es lo que sumaría si se mantiene el ritmo actual.</p></div>
          ${tit.length ? `<ul class="rl-tit">${tit.map(t => `<li><span class="material-symbols-rounded" aria-hidden="true">${t.icon}</span><span>${esc(t.texto)}</span></li>`).join('')}</ul>` : ''}
          <div class="rl-grid">${r.grupos.map(g => tarjeta(g, unica)).join('')}</div>`;
        host._analisis = r;
    };
    // Esquemas de solo dosis: distribución, alcance por unidad y quién concentra
    window.renderRdaLecturaDosis = function (fUnits, esquema) {
        const A = window.RdaAnalisis;
        const r = A && A.analizaDosis(fUnits, esquema);
        let host = document.getElementById('rdaLecturaCorte');
        if (!r) { if (host) host.remove(); return; }
        const grid = document.getElementById('rdaAnalysisGrid');
        if (!grid) return;
        if (!host) {
            host = document.createElement('section');
            host.id = 'rdaLecturaCorte';
            host.className = 'rl';
            host.setAttribute('aria-label', 'Lectura del esquema');
            grid.parentElement.insertBefore(host, grid);
        }
        const unica = fUnits.length <= 1;
        const cards = r.bios.map(b => {
            const alc = r.unidades > 0 ? b.aplicaron / r.unidades * 100 : 0;
            const top = !unica && b.top.length ? `<div class="rl-sub">Quién más aplicó</div>` + b.top.map(f => `
                <div class="rl-fila"><span class="rl-nom" title="${esc(f.nombre)} · ${esc(f.municipio)}">${esc(corto(f.nombre))}</span>
                <span class="rl-barra"><i style="width:${Math.max(4, f.dosis / b.top[0].dosis * 100)}%;background:#0284c7"></i></span>
                <span class="rl-num">${n0(f.dosis)}</span></div>`).join('') : '';
            return `<article class="rl-card">
              <header><h4>${esc(b.label)}</h4><span class="rl-pill" style="color:#0f172a">${p1(b.share)} % del esquema</span></header>
              <div class="rl-ritmo"><div><span class="rl-k">Dosis</span><b>${n0(b.total)}</b></div>
              ${unica ? '' : `<div><span class="rl-k">Unidades que aplicaron</span><b>${b.aplicaron}</b><span class="rl-u">de ${r.unidades}</span></div>`}</div>
              ${unica ? '' : `<div class="rl-pista" aria-label="Alcance en unidades"><i class="rl-hoy" style="width:${alc}%;border-radius:6px"></i></div>
              <div class="rl-pista-txt"><span><b>${p1(alc)} %</b> de las unidades registran dosis${b.sin ? ` · ${b.sin} sin dosis` : ''}</span></div>`}
              ${top}</article>`;
        }).join('');
        const muni = !unica && r.municipios.length > 1 ? `<div class="rl-sub" style="margin-top:18px">Dosis por municipio</div>` + r.municipios.map(m => `
            <div class="rl-fila rl-fila-m"><span class="rl-nom">${esc(m.municipio)}</span>
            <span class="rl-barra"><i style="width:${r.total > 0 ? Math.max(2, m.dosis / r.municipios[0].dosis * 100) : 0}%;background:#0369a1"></i></span>
            <span class="rl-num">${n0(m.dosis)} · ${r.total > 0 ? p1(m.dosis / r.total * 100) : '0,0'} %</span></div>`).join('') : '';
        host.innerHTML = `
          <div class="rl-head"><h3>Lectura del esquema</h3>
            <p>Este esquema no tiene población meta: se lee cuánto pesa cada biológico, cuántas unidades lo aplican y quién concentra las dosis.</p></div>
          ${r.titulares.length ? `<ul class="rl-tit">${r.titulares.map(t => `<li><span class="material-symbols-rounded" aria-hidden="true">${t.icon}</span><span>${esc(t.texto)}</span></li>`).join('')}</ul>` : ''}
          <div class="rl-grid rl-grid-d">${cards}</div>${muni}`;
        host._analisis = r;
    };
    // Vista "Por biológico" del esquema básico: un biológico por tarjeta, del más rezagado al más avanzado
    window.renderRdaLecturaBio = function (fUnits, mm) {
        const A = window.RdaAnalisis;
        const r = A && A.analizaBiologicos(fUnits, mm);
        let host = document.getElementById('rdaLecturaCorte');
        if (!r || !r.bios.length) { if (host) host.remove(); return; }
        const grid = document.getElementById('rdaAnalysisGrid');
        if (!grid) return;
        if (!host) {
            host = document.createElement('section');
            host.id = 'rdaLecturaCorte';
            host.className = 'rl';
            host.setAttribute('aria-label', 'Lectura por biológico');
            grid.parentElement.insertBefore(host, grid);
        }
        const unica = fUnits.length <= 1;
        const cards = r.orden.map(b => {
            const nv = NIVEL[b.nivel];
            const tot = b.unidadesConMeta;
            const sem = !unica && tot > 1 ? `<div class="rl-semaforo" style="margin-top:12px">${['optimo', 'regular', 'critico'].filter(k => b.niveles[k] > 0)
                .map(k => `<span class="rl-seg" style="flex:${b.niveles[k]};background:${NIVEL[k].color}" title="${NIVEL[k].txt}: ${b.niveles[k]}"></span>`).join('')}</div>
                <div class="rl-legs">${['optimo', 'regular', 'critico'].map(k => `<span class="rl-leg"><i class="rl-dot" style="background:${NIVEL[k].color}"></i>${b.niveles[k]} ${NIVEL[k].txt.toLowerCase()}${b.niveles[k] === 1 ? '' : 's'}</span>`).join('')}</div>` : '';
            const top = !unica && b.peores.length ? `<div class="rl-sub">Donde más falta</div>` + b.peores.map(f => `
                <div class="rl-fila"><span class="rl-nom" title="${esc(f.nombre)} · ${esc(f.municipio)}">${esc(corto(f.nombre))}</span>
                <span class="rl-barra"><i style="width:${Math.max(4, f.brecha / b.peores[0].brecha * 100)}%;background:${NIVEL[f.nivel].color}"></i></span>
                <span class="rl-num">−${n0(f.brecha)}</span></div>`).join('') : '';
            return `<article class="rl-card">
              <header><h4>${esc(b.nombre)}</h4><span class="rl-pill" style="color:${nv.ink}"><span class="material-symbols-rounded" aria-hidden="true">${nv.icon}</span>${nv.txt} · ${p1(b.avance)} %</span></header>
              <div class="rl-pista"><i class="rl-hoy" style="width:${Math.min(100, b.avance)}%;border-radius:6px;background:${nv.color}"></i><i class="rl-marca rl-m-100" style="left:100%"></i></div>
              <div class="rl-pista-txt"><span><b>${n0(b.dosis)}</b> dosis de <b>${n0(b.meta)}</b> de meta al corte${b.multi ? ' · suma las 3 dosis del esquema' : ''}</span></div>
              ${sem}${top}</article>`;
        }).join('');
        host.innerHTML = `
          <div class="rl-head"><h3>Lectura por biológico</h3>
            <p>Corte a ${esc(MESES[r.mm - 1])} · ${r.mm} de 12 meses. Cada biológico se mide contra la meta al corte de su grupo de edad; van del más rezagado al más avanzado.</p></div>
          ${r.titulares.length ? `<ul class="rl-tit">${r.titulares.slice(0, 4).map(t => `<li><span class="material-symbols-rounded" aria-hidden="true">${t.icon}</span><span>${esc(t.texto)}</span></li>`).join('')}</ul>` : ''}
          <div class="rl-grid rl-grid-b" style="--rl-cols:${r.orden.length % 3 === 0 ? 3 : (r.orden.length % 4 === 0 ? 4 : 3)}">${cards}</div>`;
        host._analisis = r;
    };

    // Comparativa multianual: devuelve el HTML (la vista arma su contenido con una plantilla de texto)
    window.rdaLecturaComparativaHtml = function (u25, u26, mm25, mm26) {
        const A = window.RdaAnalisis;
        if (!A || !A.comparaAnios) return '';
        const r = A.comparaAnios(u25, u26, mm25, mm26);
        if (!r.grupos.some(g => g.comparables > 0)) return '';
        const f1 = (n) => p1(n);
        const filas = (lista, signo) => lista.map(f => `
            <div class="rl-fila"><span class="rl-nom" title="${esc(f.nombre)} · ${esc(f.municipio)}">${esc(corto(f.nombre))}</span>
            <span class="rl-barra"><i style="width:${Math.min(100, Math.max(4, Math.abs(f.delta)))}%;background:${signo > 0 ? '#10b981' : '#e11d48'}"></i></span>
            <span class="rl-num">${signo > 0 ? '+' : ''}${f1(f.delta)}</span></div>`).join('');
        const cards = r.grupos.filter(g => g.comparables > 0).map(g => {
            const tot = g.comparables;
            const seg = [['mejoran', '#10b981', 'avanzan más'], ['estables', '#94a3b8', 'se mantienen'], ['caen', '#e11d48', 'van por debajo']]
                .filter(([k]) => g[k] > 0).map(([k, c, t]) => `<span class="rl-seg" style="flex:${g[k]};background:${c}" title="${g[k]} ${t}"></span>`).join('');
            return `<article class="rl-card">
              <header><h4>${esc(g.nombre)}</h4><span class="rl-pill" style="color:#0f172a">${tot} unidades comparables</span></header>
              <div class="rl-semaforo" style="margin-top:12px">${seg}</div>
              <div class="rl-legs"><span class="rl-leg"><i class="rl-dot" style="background:#10b981"></i>${g.mejoran} avanzan más</span><span class="rl-leg"><i class="rl-dot" style="background:#94a3b8"></i>${g.estables} se mantienen</span><span class="rl-leg"><i class="rl-dot" style="background:#e11d48"></i>${g.caen} van por debajo</span></div>
              ${g.peores.length ? `<div class="rl-sub">Mayores caídas (puntos)</div>${filas(g.peores, -1)}` : ''}
              ${g.mejores.length ? `<div class="rl-sub">Mayores avances (puntos)</div>${filas(g.mejores, 1)}` : ''}
            </article>`;
        }).join('');
        const nota = mm25 !== mm26 ? `El 2025 se toma completo (${mm25} meses) y el 2026 a ${mm26}; el avance se calcula contra la meta de los meses de cada corte, así que los porcentajes sí son comparables.` : 'Mismo corte en ambos años.';
        return `<section class="rl" id="rdaLecturaComparativa" style="margin:0 0 32px" aria-label="Lectura de la comparación">
          <div class="rl-head"><h3>Lectura de la comparación</h3><p>${esc(nota)} Se comparan las unidades presentes en los dos años; "avanzan más" y "van por debajo" usan una banda de ±3 puntos.</p></div>
          ${r.titulares.length ? `<ul class="rl-tit">${r.titulares.map(t => `<li><span class="material-symbols-rounded" aria-hidden="true">${t.icon}</span><span>${esc(t.texto)}</span></li>`).join('')}</ul>` : ''}
          <div class="rl-grid">${cards}</div></section>`;
    };
    window.removeRdaLectura = function () { document.getElementById('rdaLecturaCorte')?.remove(); };
})();

;
