                        top: 58,
                        left: 'center',
                        textStyle: { fontFamily: fontModern, fontWeight: 800, color: '#334155', fontSize: 12 }
                    },
                    grid: { left: '3%', right: '3%', bottom: '8%', top: 98, containLabel: true },
                    xAxis: {
