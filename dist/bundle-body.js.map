                        data: ['Menores de 1 Año (<1)', 'Niños de 1 Año (1)', 'Niños de 4 Años (4)'],
                        axisLabel: { fontFamily: fontModern, fontWeight: 800, color: '#0f172a', fontSize: 12 }
                    },
                    yAxis: {
